@page "/painel/pedidos/{id:guid}"
@using CakeBoss.Backend.Features.Orders
@using CakeBoss.Frontend.Site
@model DetailsModel
@{
    var order = Model.Order!;
    ViewData["Title"] = $"Pedido {order.Code}";

    var firstName = order.Customer.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries)[0];
    var rejected = order.Status == OrderStatus.Rejected;
    var cancelled = order.Status == OrderStatus.Cancelled;
}

<section class="section">
    <div class="container">
        <p class="panel-back"><a asp-page="/Panel/Index">&larr; Pedidos</a></p>

        <header class="page-head">
            <h1>Pedido @order.Code</h1>
            <p><span class="status-pill status-@order.Status.ToString().ToLowerInvariant()">@FormOptions.PanelStatusLabel(order.Status)</span></p>
        </header>

        <div class="order-form">
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-success" role="status">@Model.Message</div>
            }

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            @if (order.Status == OrderStatus.Pending)
            {
                <div class="form-card text-center">
                    <p class="mb-3">Combine com @firstName o valor e o sinal. A mensagem já vai pronta com o pedido.</p>
                    <a class="btn btn-cb" href="@order.WhatsApp.Link" target="_blank" rel="noopener">Chamar @firstName no WhatsApp</a>
                    <p class="form-hint mt-3 mb-0">Depois de combinar, registre o que ficou combinado em "Aprovar o pedido", mais abaixo.</p>
                </div>
            }

            @if (rejected || cancelled)
            {
                <div class="form-card">
                    <h2>@(rejected ? "Pedido recusado" : "Pedido cancelado")</h2>
                    @{
                        var reason = rejected ? order.RejectionReason : order.CancellationReason;
                    }
                    <p class="mb-0">@(string.IsNullOrWhiteSpace(reason) ? "Sem motivo informado." : reason)</p>
                    @if (cancelled)
                    {
                        <p class="form-hint mt-2 mb-0">@(order.DepositKept ? "O sinal foi retido." : "O sinal não foi retido.")</p>
                    }
                </div>
            }

            <div class="form-card">
                <h2>Cliente</h2>
                <dl class="summary-list">
                    <dt>Nome</dt>
                    <dd>@order.Customer.Name</dd>

                    <dt>Telefone</dt>
                    <dd><a href="tel:+55@order.Customer.Phone">@FormOptions.FormatPhone(order.Customer.Phone)</a></dd>

                    @if (!string.IsNullOrWhiteSpace(order.Customer.Email))
                    {
                        <dt>E-mail</dt>
                        <dd><a href="mailto:@order.Customer.Email">@order.Customer.Email</a></dd>
                    }
                </dl>
            </div>

            <div class="form-card">
                <h2>Pedido</h2>
                <dl class="summary-list">
                    <dt>Data e horário</dt>
                    <dd>@FormOptions.FormatDate(order.Date) às @order.Time.ToString("HH:mm")</dd>

                    <dt>@FormOptions.DeliveryLabel(order.DeliveryType)</dt>
                    <dd>@(order.DeliveryAddress ?? "O cliente retira na confeitaria")</dd>

                    @for (var i = 0; i < order.Items.Count; i++)
                    {
                        var item = order.Items[i];
                        <dt>@(order.Items.Count > 1 ? $"Bolo {i + 1}" : "Bolo")</dt>
                        <dd>
                            Massa de @item.Batter, recheio de @string.Join(" e ", item.Fillings), cobertura de @item.Frosting,
                            @FormOptions.FormatWeight(item.WeightKg).
                            <br />
                            <span class="form-hint">@item.Decoration</span>
                        </dd>
                    }

                    <dt>Pagamento do restante</dt>
                    <dd>@FormOptions.PaymentLabel(order.PaymentMethod)</dd>

                    @if (!string.IsNullOrWhiteSpace(order.Notes))
                    {
                        <dt>Observações do cliente</dt>
                        <dd>@order.Notes</dd>
                    }
                </dl>
            </div>

            @if (order.Price is not null)
            {
                <div class="form-card">
                    <h2>Valores combinados</h2>
                    <dl class="money-list">
                        <dt>Bolo</dt>
                        <dd>@FormOptions.FormatMoney(order.Price.Value)</dd>

                        @if (order.DeliveryFee is > 0)
                        {
                            <dt>Taxa de entrega</dt>
                            <dd>@FormOptions.FormatMoney(order.DeliveryFee.Value)</dd>
                        }

                        <dt class="is-total">Total</dt>
                        <dd class="is-total">@FormOptions.FormatMoney(order.Total ?? 0)</dd>

                        @if (order.DepositAmount is > 0)
                        {
                            <dt>Sinal (Pix)</dt>
                            <dd>
                                @FormOptions.FormatMoney(order.DepositAmount.Value)
                                <span class="form-hint">@(order.DepositPaid ? "pago" : "aguardando")</span>
                            </dd>
                        }

                        @* O backend só desconta o sinal depois que ele é pago. *@
                        <dt>@(order.DepositPaid ? "Restante, na retirada ou entrega" : "Falta pagar")</dt>
                        <dd>@FormOptions.FormatMoney(order.RemainingAmount ?? 0)</dd>
                    </dl>

                    @if (order.BlocksWholeDay)
                    {
                        <p class="form-hint mt-3 mb-0">Este pedido ocupa o dia inteiro na agenda.</p>
                    }
                </div>
            }

            @* As ações vêm por último: a dona lê o pedido todo antes de aprovar, recusar ou cancelar. *@
            <partial name="_OrderActions" model="Model" />
        </div>
    </div>
</section>
