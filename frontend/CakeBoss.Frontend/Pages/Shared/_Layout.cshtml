@inject Microsoft.Extensions.Options.IOptions<CakeBoss.Frontend.Site.SiteOptions> SiteOptions
@{
    var site = SiteOptions.Value;
    var pageTitle = ViewData["Title"] as string;
    var title = string.IsNullOrWhiteSpace(pageTitle) ? site.Name : $"{pageTitle} · {site.Name}";
    var description = ViewData["Description"] as string ?? site.Tagline;

    // As páginas do painel (_PanelLayout) trazem a própria barra: sem cabeçalho e rodapé do site, e fora dos buscadores.
    var panelMode = ViewData["PanelMode"] is true;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@description" />
    <meta name="theme-color" content="#793698" />
    @if (panelMode)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    <title>@title</title>

    @* Fontes: Lobster nos títulos (cursiva), Cormorant Garamond no nome da confeitaria e Nunito no texto (arredondada, fácil de ler no celular). *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,700&family=Lobster&family=Nunito:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    @if (!panelMode)
    {
        <partial name="_Header" />
    }

    <main id="conteudo" class="site-main">
        @RenderBody()
    </main>

    @if (!panelMode)
    {
        <partial name="_Footer" />
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
